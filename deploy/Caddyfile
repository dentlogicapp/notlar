# Caddyfile - notlar.dentlogicapp.com + api.dentlogicapp.com
# Caddy otomatik Let's Encrypt SSL alır (HTTP-01 challenge, port 80 açık olmalı)

{
    email dentlogicapp@gmail.com
}

notlar.dentlogicapp.com {
    encode gzip zstd
    reverse_proxy frontend:3000

    header {
        # v18 Asama 21 - CSP (connect-src api subdomain ZORUNLU; script/style unsafe-inline Next.js+Tailwind icin)
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: https:; connect-src 'self' https://api.dentlogicapp.com; frame-ancestors 'none'; form-action 'self'; base-uri 'self';"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        -Server
    }
}

api.dentlogicapp.com {
    encode gzip zstd
    reverse_proxy backend:8080

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }
}
