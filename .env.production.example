# PRODUCTION .env
# Bu dosyayı sunucuda /opt/notlar/.env olarak kopyala ve değerleri doldur
# ASLA git'e commit etme!

# PostgreSQL — guclu sifreler
POSTGRES_DB=notlar
POSTGRES_USER=notlaruser
POSTGRES_PASSWORD=DEGISTIR_GUCLU_RANDOM_SIFRE_BURAYA

# JWT - en az 32 karakter random
# Uretmek icin: openssl rand -base64 48
JWT_SECRET=DEGISTIR_OPENSSL_RAND_BASE64_48_CIKTISI

# Gmail SMTP
# 1. https://myaccount.google.com -> Security -> 2-Step Verification (acik olmali)
# 2. https://myaccount.google.com/apppasswords -> "Mail" icin uretip al
# 3. SMTP_PASS o 16 haneli sifre (bosluksuz)
SMTP_USER=dentlogicapp@gmail.com
SMTP_PASS=DEGISTIR_GMAIL_APP_PASSWORD_16_HANE
SMTP_FROM=dentlogicapp@gmail.com

# Ilk admin
ILK_ADMIN_EMAIL=dentlogicapp@gmail.com
ILK_ADMIN_AD=Musa Deveci
# Bu sifreyi acilis sonrasi giris icin kullanacaksin, sonra UI'dan degistirebilirsin
ILK_ADMIN_SIFRE=DEGISTIR_ILK_ADMIN_SIFRESI
